# Vidriera bouquet — variables de entorno.
# Copiar a .env.local (nunca commitear: el .gitignore de la raíz ya excluye
# .env y .env.* salvo este ejemplo).

# --- Firebase Admin SDK (SOLO se lee en apps/tienda/src/server/**) ----------
# ADR 004: todo acceso a Firestore de la vidriera va por acá, nunca desde el
# navegador. Sacadas del JSON de la service account. Ninguna lleva el prefijo
# NEXT_PUBLIC_ — eso las inlinearía en el bundle del cliente
# (scripts/hooks/server-only-guard.sh, regla 4).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# La clave privada tal como viene en el JSON, con los "\n" literales: se
# reemplazan por saltos de línea reales en src/server/firebase-admin.ts.
FIREBASE_PRIVATE_KEY=

# --- Webhook de revalidación (ADR 004 §2) -----------------------------------
# El trigger `revalidarVidriera` de functions/ (todavía no existe, ARQUITECTURA
# §12 paso 4) lo manda en el header x-revalidacion-secret al hacer POST a
# /api/revalidar. Sin este secreto cualquiera podría forzar revalidaciones.
REVALIDACION_SECRET=

# --- Cloud Functions callables: crearOrden, consultarOrden ------------------
# Base URL de las functions desplegadas (ej.
# https://us-central1-<proyecto>.cloudfunctions.net). TODO: functions/crearOrden
# y functions/consultarOrden todavía no existen (ARQUITECTURA §12, paso 4) —
# otra tarea las está escribiendo. Sin esta variable, el checkout y la consulta
# de pedido devuelven un error explícito en vez de fallar en silencio.
FUNCTIONS_BASE_URL=

# --- Público: se inlinea en el bundle A PROPÓSITO ---------------------------
# Usada por src/app/sitemap.ts para armar URLs absolutas.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
