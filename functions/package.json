{
  "name": "@bouquet/functions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "construir": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --outfile=lib/index.js --external:sharp --external:firebase-admin --external:firebase-admin/* --external:firebase-functions --external:firebase-functions/*",
    "tipos": "tsc --noEmit --project .",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^6.5.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
