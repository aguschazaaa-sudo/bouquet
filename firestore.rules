rules_version = '2';

// ===========================================================================
// bouquet - reglas de Firestore.  ARQUITECTURA §9.
//
// LA POSTURA: TODO DENEGADO para el navegador anonimo.  Y no es paranoia: es
// que NO LO NECESITA.  La vidriera renderiza del lado servidor (SSR con cache
// de borde purgada por tag, ADR 005), asi que el visitante NUNCA tiene un SDK
// de Firestore en la mano.  El dia que haga falta una lectura desde el
// cliente, se abre ESA lectura a proposito y se escribe por que.
//
// EL AGUJERO QUE ESTAS REGLAS EXISTEN PARA NO REPETIR: en PadelPunilla las
// reglas permitian que el creador de una Reserva mutara su propio `estado`, o
// sea que un jugador se auto-confirmaba salteando la aprobacion del club.  Lo
// encontro una revision de DISENIO, no una de seguridad, porque revisar una
// pantalla en serio obliga a preguntar quien puede apretar cada boton.
//
// Traducido a una tienda de vinos: SI EL COMPRADOR PUEDE ESCRIBIR
// `estadoPago`, LA TIENDA REGALA VINO.  De ahi que el eje de pago sea
// server-only y que ni el operador pueda tocarlo por escritura directa.
//
// La pregunta que se hace por cada campo escribible:
//   ¿quien puede escribir esto, y QUE GANA si miente?
// ===========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- roles
    //
    // §9.2: el rol va en un CUSTOM CLAIM, no en un documento.
    //
    // `get(/databases/$(database)/documents/usuarios/$(uid)).data.rol` cuesta
    // UNA LECTURA FACTURADA POR CADA EVALUACION.  Con el panel abierto sobre
    // una lista de 200 productos son 200 lecturas extra por pantalla, y son
    // INVISIBLES en cualquier auditoria de codigo porque no aparecen en
    // ninguna query.  Contra una cuota de 50.000/dia (§6.3) eso se nota.
    //
    // Ademas un documento se puede falsificar si es escribible; un claim lo
    // firma el Admin SDK.
    function esAdmin() {
      return request.auth != null && request.auth.token.rol == 'admin';
    }

    function editaSolo(permitidos) {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(permitidos);
    }

    function esSlug(s) {
      return s is string && s.matches('[a-z0-9]+(-[a-z0-9]+)*');
    }

    // ------------------------------------------------------------ productos
    //
    // §5.2 y ADR 008 - las trampas que se cierran ACA:
    //
    //  · `publicado` SIEMPRE presente.  `where('publicado','==',true)` NO
    //    devuelve los documentos donde el campo no existe.  Somos greenfield,
    //    asi que la defensa correcta no es un backfill: es que NINGUN
    //    documento pueda nacer sin el campo.
    //
    //  · `precio` ENTERO en centavos de ARS.  Nunca float, nunca string.
    //    `is int` rechaza 1250.50 y rechaza "1250".
    //
    //  · `imagenes` UN SOLO array de URLs.  En PadelPunilla convivieron DOS
    //    campos `photoUrl` -uno anidado y uno en la raiz- desde el commit
    //    inicial, y aun con la subida arreglada la foto nueva no se veia en
    //    ningun otro lado, PARA SIEMPRE.  Un dato, una ruta.
    //
    //  · LOS OBLIGATORIOS SE EXIGEN EN TODO UPDATE, NO "SI VIENEN".  La
    //    version anterior validaba `precio` solo si estaba en el documento
    //    resultante, asi que un update que lo BORRABA pasaba: un producto
    //    publicado sin precio. Ahora create y update pasan por la misma
    //    `productoValido`, que exige los obligatorios y cierra el documento
    //    con hasOnly -tambien adentro de los mapas: affectedKeys() no mira
    //    adentro de un mapa, asi que cada mapa se valida entero-.
    //
    //  · `stock` y `muestra` son del SERVIDOR.  El panel crea un simple con
    //    stock == 0 y la reposicion llega por callable con increment.  La
    //    regla ve el documento RESULTANTE, no la operacion: no distingue un
    //    increment(10) de un valor absoluto calculado sobre un dato viejo, y
    //    por eso el panel no escribe stock en absoluto.
    //
    //  · `tipo` y `presentacion` son INMUTABLES.  Una botella suelta que pasa
    //    a caja de 2 cambia lo que significa cada unidad de `stock`: es otro
    //    producto, no una edicion.  Y `tipo` existe para que nadie deduzca
    //    "compuesto" por la falta de `stock`, que dejaria a la venta un
    //    producto mal cargado.

    // VARIETALES: la MISMA lista que packages/contratos/src/producto.ts.
    // scripts/ci/auditar_varietales.mjs compara las dos y sale con 1 si
    // difieren.  Agregar una uva es un cambio en los dos lugares.
    function varietalesValidos(v) {
      return v is list
        && v.size() > 0
        && v.toSet().size() == v.size()
        && v.hasOnly([
          // varietales:inicio
          'Malbec',
          'Cabernet Sauvignon',
          'Cabernet Franc',
          'Bonarda',
          'Syrah',
          'Merlot',
          'Pinot Noir',
          'Pinot Grigio',
          'Tannat',
          'Petit Verdot',
          'Tempranillo',
          'Criolla',
          'Chardonnay',
          'Torrontés',
          'Sauvignon Blanc',
          'Semillón',
          'Viognier',
          'Pinot Gris'
          // varietales:fin
        ]);
    }

    // GRADUACION: DECIMAS de grado, entero (13,5 % es 135), opcional como la
    // anada.  Los mismos dos numeros que GRADUACION_MINIMA y GRADUACION_MAXIMA
    // de packages/contratos/src/producto.ts.  El piso no describe a los vinos:
    // atrapa la UNIDAD EQUIVOCADA -un `14` pensado como 14 % valdria 1,4 %-.
    // `13.5` no es int y `1350` se pasa del techo: cada confusion rebota.
    // ADR 013.
    function graduacionValida(f) {
      return !('graduacion' in f) || f.graduacion == null
        || (f.graduacion is int && f.graduacion >= 50 && f.graduacion <= 250);
    }

    // DESCRIPCION: prosa del duenio, opcional.  El 600 es el mismo numero que
    // DESCRIPCION_MAXIMA de packages/contratos/src/producto.ts, y vive aca
    // porque el catalogo ENTERO viaja al navegador para filtrarse en memoria
    // (ADR 006): un texto sin tope lo paga cada visitante, no solo quien abre
    // esa ficha.  Un formulario se saltea; una regla no.
    //
    // Ausente y null son lo mismo -"no se cargo"-.  Una cadena en blanco NO,
    // porque serian dos maneras de decir nada y dos de leerla.
    function descripcionValida(f) {
      return !('descripcion' in f) || f.descripcion == null
        || (f.descripcion is string
            && f.descripcion.trim().size() > 0
            && f.descripcion.size() <= 600);
    }

    function fichaValida(f) {
      return f is map
        && f.keys().hasAll(['bodegaId', 'varietales', 'color', 'organico', 'region', 'volumenMl'])
        && f.keys().hasOnly(['bodegaId', 'varietales', 'color', 'organico', 'anada', 'region', 'volumenMl', 'graduacion', 'descripcion'])
        && f.bodegaId is string && f.bodegaId.size() > 0
        && varietalesValidos(f.varietales)
        && f.color in ['tinto', 'blanco', 'rosado']
        && f.organico is bool
        && (!('anada' in f) || f.anada == null || (f.anada is int && f.anada > 1800))
        && f.region is string && f.region.size() > 0
        && f.volumenMl is int && f.volumenMl > 0
        && graduacionValida(f)
        && descripcionValida(f);
    }

    // CADA IMAGEN ES UNA URL https.  Las reglas NO iteran: no hay map, filter
    // ni for.  Como el tope son 10, se escribe una condicion por indice, y
    // cada una se cumple sola cuando la lista es mas corta.  Es largo y es
    // demostrable; una lista sin tope no se podria escribir asi, y por eso el
    // tope va primero.
    //
    // Importa porque armarCatalogo exige el https:// y DESCARTA el producto
    // entero de la vidriera sin un error visible: la regla y la proyeccion
    // tienen que pedir lo mismo.  La lista vacia sigue siendo valida: un vino
    // sin foto se publica y la vidriera dibuja la silueta.
    function imagenValida(l, i) {
      return l.size() <= i || (l[i] is string && l[i].matches('https://.+'));
    }

    function imagenesValidas(l) {
      return l is list && l.size() <= 10
        && imagenValida(l, 0) && imagenValida(l, 1) && imagenValida(l, 2)
        && imagenValida(l, 3) && imagenValida(l, 4) && imagenValida(l, 5)
        && imagenValida(l, 6) && imagenValida(l, 7) && imagenValida(l, 8)
        && imagenValida(l, 9);
    }

    // UN PUBLICADO TIENE PRECIO.  Un borrador nace en 0 y se completa despues,
    // asi que el 0 solo se prohibe cuando el vino esta en la tienda.  Sin
    // esto se puede publicar con `precio: 0`, pasa el validador, y un
    // `precioUnitarioVisto: 0` coincidiria cuando exista crearOrden
    // (hallazgo 2 de revisor-pagos, ADR 008).
    function precioCoherente(d) {
      return d.publicado == false || d.precio > 0;
    }

    function productoValido(d) {
      return d.keys().hasAll(['tipo', 'slug', 'nombre', 'precio', 'presentacion', 'imagenes', 'publicado', 'fichaVino'])
        && d.keys().hasOnly(['tipo', 'slug', 'nombre', 'precio', 'stock', 'presentacion', 'imagenes', 'publicado', 'muestra', 'fichaVino'])
        && d.tipo in ['simple', 'compuesto']
        && esSlug(d.slug)
        && d.nombre is string && d.nombre.size() > 0
        && d.precio is int && d.precio >= 0
        && d.presentacion is map
        && d.presentacion.keys().hasOnly(['botellas'])
        && d.presentacion.botellas is int && d.presentacion.botellas >= 1
        && imagenesValidas(d.imagenes)
        && d.publicado is bool
        && precioCoherente(d)
        && fichaValida(d.fichaVino)
        // El simple lleva stock entero; el compuesto no tiene stock propio:
        // lo deriva de sus componentes.
        && ((d.tipo == 'simple' && 'stock' in d && d.stock is int && d.stock >= 0)
            || (d.tipo == 'compuesto' && !('stock' in d)));
    }

    // EL ID ES EL SLUG (ADR 013).  Firestore no deja que dos documentos
    // compartan id, asi que la unicidad del slug la da la base POR
    // CONSTRUCCION: cero get(), cero colecciones de reserva.  La alternativa
    // que dejo anotada ADR 008 -`slugs/{slug}` con getAfter()- costaba una
    // lectura FACTURADA POR EVALUACION.  Dos productos publicados con el mismo
    // slug quedan afuera LOS DOS de la vidriera (armarCatalogo), sin un error:
    // por eso importa.
    //
    // Y el slug NO CAMBIA en un update: si cambiara, el id y el slug dejarian
    // de coincidir y la garantia se caeria.  Vale tambien para los documentos
    // anteriores a esta regla, cuyo id no es su slug (los de muestra:
    // `muestra-<slug>`), que se siguen pudiendo corregir.
    match /productos/{productoId} {
      allow read: if esAdmin();

      allow create: if esAdmin()
        && productoValido(request.resource.data)
        && request.resource.data.slug == productoId
        && !('muestra' in request.resource.data)
        // Nace sin stock: el primero llega por la reposicion, del servidor.
        && request.resource.data.get('stock', 0) == 0;

      allow update: if esAdmin()
        && productoValido(request.resource.data)
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.tipo == resource.data.tipo
        && request.resource.data.presentacion == resource.data.presentacion
        && request.resource.data.get('stock', null) == resource.data.get('stock', null)
        && request.resource.data.get('muestra', null) == resource.data.get('muestra', null);

      // UN PRODUCTO NO SE BORRA, NI SIENDO ADMIN.  El motivo es de plata, no
      // de higiene: borrar y recrear con el mismo id SE SALTEA la
      // inmutabilidad de `tipo` y de `presentacion.botellas` que el update de
      // arriba garantiza.  Una botella suelta con stock 10 recreada como caja
      // de 2 deja 12 botellas a la venta sobre 10 fisicas despues de una
      // cancelacion (hallazgo 1 de revisor-pagos, ADR 008).
      //
      // Sacar un vino de la venta es `publicado: false`, que el update de
      // arriba permite y tiene vuelta atras.  El seed sigue borrando porque
      // usa el Admin SDK (scripts/seed/proyecto.mjs), que no pasa por aca.
      allow delete: if false;

      // -------------------------------------------- movimientos de stock
      //
      // `productos/{id}/movimientos/{idMovimiento}` es el MARCADOR de
      // idempotencia de la callable `moverStock` (EP-05, ADR 016), y de paso
      // el registro de quien movio el stock, cuando y desde donde hasta
      // donde.  Lo escribe SOLO esa callable, con el Admin SDK, en la MISMA
      // transaccion que el cambio de `stock`.
      //
      // ESCRIBIRLOS esta cerrado a los clientes por el mismo motivo que
      // `ordenes/marcadores`: si el panel pudiera CREAR uno, marcaria un
      // movimiento como hecho sin que ocurra; si pudiera BORRARLO, lo dejaria
      // ocurrir dos veces.  Las dos cosas son stock.
      //
      // LEERLOS se abrio con HU-05.4 (ADR 016 §6): el panel los muestra, con
      // los mas nuevos primero.  `list` exige un `limit` de hasta 50: la
      // coleccion crece sin fin (nunca se borra) y una lectura sin limite
      // leeria TODA.  Sin `limit` la regla no evalua y rechaza; ese es el
      // efecto buscado, no un descuido.
      //
      // Esta subcoleccion NO entra en la lectura del catalogo ni en la del
      // panel: `collection('productos')` no trae subcolecciones.
      match /movimientos/{idMovimiento} {
        allow get: if esAdmin();
        allow list: if esAdmin() && request.query.limit <= 50;
        allow create, update, delete: if false;
      }
    }

    // -------------------------------------------------------------- bodegas
    //
    // El panel las da de alta.  La forma se cierra en `nombre` y `slug`: la
    // vidriera las lee ENTERAS en cada reconstruccion del catalogo, y cada
    // campo de mas es peso en esa lectura.  `muestra` es del servidor, igual
    // que en productos.
    match /bodegas/{bodegaId} {
      allow read: if esAdmin();
      allow create: if esAdmin()
        && request.resource.data.keys().hasOnly(['nombre', 'slug'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && esSlug(request.resource.data.slug);
      allow update: if esAdmin()
        && request.resource.data.keys().hasOnly(['nombre', 'slug', 'muestra'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && esSlug(request.resource.data.slug)
        && request.resource.data.get('muestra', null) == resource.data.get('muestra', null);
      allow delete: if esAdmin();
    }

    // ------------------------------------------------------------- metricas
    //
    // `metricas/popularidad`: UN documento que se RECALCULA entero sobre una
    // ventana de tiempo y nunca se acumula (ADR 008).  Un contador que suma de
    // a una venta se infla con cada reintento del trigger; uno recalculado da
    // lo mismo si corre dos veces.  Lo escribe solo el servidor; el panel lo
    // lee.  La vidriera recibe el PUESTO, nunca las unidades.
    match /metricas/{documento} {
      allow read: if esAdmin();
      allow write: if false;
    }

    // ------------------------------------------------------ cajas sugeridas
    //
    // `cajasSugeridas/publicas`: UN documento con las cajas que el vendedor
    // ofrece ya armadas.  Mismo patron que `metricas/popularidad` -- se
    // reescribe entero, asi que cargarlo dos veces da lo mismo.
    //
    // Una caja sugerida NO es un producto: no tiene precio ni stock propio, es
    // una lista de `productoId` que LLENA EL CARRITO.  El precio sale de la
    // proyeccion del momento, como en cualquier linea.
    //
    // POR QUE LA ESCRITURA ESTA CERRADA INCLUSO PARA EL ADMIN: la unica regla
    // que importa de una caja es que SUME una caja, y eso solo se sabe mirando
    // `presentacion.botellas` de cada producto.  Comprobarlo aca serian SEIS
    // `get()` FACTURADOS POR ESCRITURA, que es exactamente el costo invisible
    // que estas reglas evitan con el custom claim.  La composicion la verifica
    // `verificarComposicion` en contratos, del lado del servidor.
    //
    // La vidriera lo lee con el Admin SDK: no pasa por aca.
    match /cajasSugeridas/{documento} {
      allow read: if esAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------------- ordenes
    //
    // El operador LEE y puede mover la ENTREGA a mano desde el panel.  Lo que
    // NO puede es escribir `estadoPago` por escritura directa, ni tocar
    // `items[]`, `total` o `numero` de una orden ya creada.
    //
    // POR QUE: `items[]` es un SNAPSHOT de precios al momento de la compra
    // (§5.2), no una referencia.  Si se puede editar despues, deja de ser un
    // snapshot y el historico de la tienda se vuelve mentira -- justo lo que
    // el snapshot existe para evitar.
    //
    // El cliente NO figura aca en absoluto.  Consulta su orden por la
    // callable `consultarOrden(numero, email)` (§9.1): una lectura directa
    // por id permite ENUMERAR ORDENES AJENAS probando ids.
    match /ordenes/{ordenId} {
      // LEER: el detalle (`get`) sin tope, y la bandeja (`list`) con `limit`
      // de hasta 50.  Sin `limit` la regla no evalua y rechaza, y ese es el
      // efecto buscado: una lista sin limite leeria TODAS las ordenes, y es
      // la unica coleccion del proyecto que crece sin fin con el negocio
      // (ADR 018 §7).  La bandeja pide 25.
      allow get: if esAdmin();
      allow list: if esAdmin() && request.query.limit <= 50;

      // Las ordenes nacen SOLO por la transaccion de una callable (Admin SDK):
      // hoy `crearOrdenDelPanel` (ADR 018), y `crearOrden` de la vidriera cuando
      // exista.  Son las unicas que saben asignar `numero` contra
      // `contadores/ordenes`.  Nadie las crea desde un cliente.
      allow create: if false;

      // El panel mueve la ENTREGA a mano y anota; nada mas.  Y lo que escribe
      // tiene que tener sentido: `affectedKeys()` incluye las claves BORRADAS,
      // asi que `deleteField()` sobre `estadoEntrega` pasaba el `hasOnly` y la
      // orden desaparecia de toda bandeja, porque `where('estadoEntrega', '==',
      // X)` no la trae -- la trampa de `publicado` (hallazgo 4 de
      // `revisor-pagos`).  Leer un campo que no existe hace fallar la regla, que
      // es lo que se quiere.
      //
      // Desde EP-07 (ADR 019) la regla valida la TRANSICION, no solo el valor:
      // antes un panel con un error podia pasar una orden de `entregada` a
      // `sin_preparar` y esto lo aceptaba (hallazgo 3 del mapa del panel).  Cuesta
      // CERO lecturas: el estado de antes es `resource.data`, que ya esta.
      allow update: if esAdmin()
        && request.resource.data.estadoEntrega in
             ['sin_preparar', 'preparando', 'despachada', 'entregada', 'fallida', 'cancelada']
        && (!('notasOperador' in request.resource.data)
            || (request.resource.data.notasOperador is string
                && request.resource.data.notasOperador.size() <= 1000))
        && (!('actualizadaEn' in request.resource.data)
            || request.resource.data.actualizadaEn is timestamp)
        && (anota() || pasoDeEntrega());

      // El MISMO estado: se anota y nada mas.  Por eso un segundo "despachar"
      // sobre una orden que otra persona ya despacho -con la pantalla vieja- se
      // rechaza: pisaria su seguimiento.
      function anota() {
        return request.resource.data.estadoEntrega == resource.data.estadoEntrega
          && editaSolo(['notasOperador', 'actualizadaEn']);
      }

      // LA TABLA DE ADR 002, menos `cancelada`.  Es la TERCERA copia de la tabla
      // (contratos y Dart son las otras) y no se sincroniza sola: la suite de
      // reglas lee `despacho.laEscribeElPanel` del JSON generado y prueba los 36
      // pares contra esto.  Si alguien cambia la tabla en `contratos` y no aca, el
      // test falla.
      //
      // ⚠️ `cancelada` NO ESTA, a proposito: cancelar DEVUELVE el stock, y eso lo
      // hace solo `cancelarOrden` (Admin SDK, no pasa por aca) en la misma
      // transaccion que el estado.  Si un cliente pudiera escribirla, un panel con
      // un error cancelaria sin reponer y el vino quedaria vendido para siempre.
      //
      // Cada paso dice ademas que campos lleva, y ningun otro.
      function pasoDeEntrega() {
        let antes = resource.data.estadoEntrega;
        let despues = request.resource.data.estadoEntrega;
        return (antes == 'sin_preparar' && despues == 'preparando'
                  && editaSolo(['estadoEntrega', 'notasOperador', 'actualizadaEn']))
          // Despachar, y volver a despachar tras una entrega fallida.  Un pedido de
          // la VIDRIERA impago no sale: si Mercado Pago no aprobo, no hay venta.
          // Uno de WHATSAPP sale sin mirar el pago, porque se cobra por fuera
          // (`sePuedeDespachar` de contratos).
          || (antes in ['preparando', 'fallida'] && despues == 'despachada'
                  && editaSolo(['estadoEntrega', 'despacho', 'notasOperador', 'actualizadaEn'])
                  && despachoValido(request.resource.data.despacho)
                  && (resource.data.origen == 'whatsapp' || resource.data.estadoPago == 'pagada'))
          || (antes == 'despachada' && despues == 'entregada'
                  && editaSolo(['estadoEntrega', 'notasOperador', 'actualizadaEn']))
          || (antes == 'despachada' && despues == 'fallida'
                  && editaSolo(['estadoEntrega', 'entregaFallida', 'notasOperador', 'actualizadaEn'])
                  && fallaValida(request.resource.data.entregaFallida));
      }

      // Copia de `CORREOS` y `LARGO_DEL_SEGUIMIENTO` (contratos/src/despacho.ts).
      // El seguimiento es opcional: una entrega en mano no tiene.  `en` es la hora
      // del SERVIDOR: un cliente no puede fechar un despacho para atras.
      function despachoValido(d) {
        return d is map
          && d.keys().hasOnly(['correo', 'seguimiento', 'en'])
          && d.keys().hasAll(['correo', 'seguimiento', 'en'])
          && d.correo in ['andreani', 'correo_argentino', 'oca', 'en_mano', 'otro']
          && (d.seguimiento == null
              || (d.seguimiento is string && d.seguimiento.size() >= 1 && d.seguimiento.size() <= 60))
          && d.en == request.time;
      }

      // Copia de `MOTIVOS_DE_FALLA`.  El motivo es obligatorio: `sin_mayor` es un
      // caso operativo real (ARQUITECTURA §9.5).
      function fallaValida(f) {
        return f is map
          && f.keys().hasOnly(['motivo', 'en'])
          && f.keys().hasAll(['motivo', 'en'])
          && f.motivo in ['sin_mayor', 'nadie', 'direccion', 'rechazo', 'otro']
          && f.en == request.time;
      }

      // Una orden no se borra: se cancela.  Cancelar es un par de estados
      // (ADR 002), no un DELETE -- y el historico de una venta no se tira.
      allow delete: if false;

      // ----------------------------------------------------- idempotencia
      //
      // Los marcadores son la defensa contra el trigger que corre dos veces.
      // Los triggers son AT-LEAST-ONCE: el mismo evento llega repetido.  El
      // marcador se escribe en la MISMA TRANSACCION que el efecto, desde el
      // Admin SDK.
      //
      // Si un cliente pudiera escribir un marcador, podria hacer que un
      // efecto NUNCA ocurra (marcandolo como ya hecho).  Si pudiera borrarlo,
      // podria hacer que ocurra DOS VECES.  Las dos cosas son plata.
      match /marcadores/{efecto} {
        allow read, write: if false;
      }
    }

    // ----------------------------------------------------------------- zonas
    // Cobertura de envio y costo.  El operador las lee; las escribe el
    // servidor.  Un costo de envio editable desde el navegador es un descuento
    // que se pone el comprador.
    match /zonas/{zonaId} {
      allow read: if esAdmin();
      allow write: if false;
    }

    // ---------------------------------------------------------------- config
    //
    // §9.4 - LA BARANDA TIENE QUE PROTEGER LA PRIMERA ESCRITURA.
    //
    // Una condicion anti fat-finger escrita sobre el valor ANTERIOR no sirve
    // en una CREACION, porque no hay "antes" -- y la primera escritura es
    // exactamente cuando mas se equivoca uno.  Por eso `config` es
    // server-only en su totalidad, creacion incluida: la baranda vive en el
    // trigger, sobre el valor NUEVO, y las reglas garantizan que no exista
    // ningun otro camino de escritura que la saltee.
    match /config/{documento} {
      allow read: if esAdmin();
      allow write: if false;
    }

    // ------------------------------------------------------------ contadores
    // Numeracion secuencial de ordenes.  Se toca UNICAMENTE dentro de la
    // transaccion de las callables que crean ordenes.  Dos escrituras concurrentes por fuera de
    // esa transaccion dan dos ordenes con el mismo numero.
    match /contadores/{nombre} {
      allow read, write: if false;
    }

    // ---------------------------------------------------- deny por defecto
    //
    // Esta clausula es redundante con el modelo de Firestore (lo que no se
    // permite, se niega) y esta puesta A PROPOSITO: hace que la intencion sea
    // legible para quien lea el archivo, y que una coleccion nueva que
    // aparezca sin su bloque quede cerrada de forma EXPLICITA en vez de
    // parecer un olvido.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
