rules_version = '2';

// ===========================================================================
// bouquet - reglas de Firestore.  ARQUITECTURA §9.
//
// LA POSTURA: TODO DENEGADO para el navegador anonimo.  Y no es paranoia: es
// que NO LO NECESITA.  La vidriera renderiza del lado servidor (SSR con cache
// de borde purgada por tag, ADR 005), asi que el visitante NUNCA tiene un SDK
// de Firestore en la mano.  El dia que haga falta una lectura desde el
// cliente, se abre ESA lectura a proposito y se escribe por que.
//
// EL AGUJERO QUE ESTAS REGLAS EXISTEN PARA NO REPETIR: en PadelPunilla las
// reglas permitian que el creador de una Reserva mutara su propio `estado`, o
// sea que un jugador se auto-confirmaba salteando la aprobacion del club.  Lo
// encontro una revision de DISENIO, no una de seguridad, porque revisar una
// pantalla en serio obliga a preguntar quien puede apretar cada boton.
//
// Traducido a una tienda de vinos: SI EL COMPRADOR PUEDE ESCRIBIR
// `estadoPago`, LA TIENDA REGALA VINO.  De ahi que el eje de pago sea
// server-only y que ni el operador pueda tocarlo por escritura directa.
//
// La pregunta que se hace por cada campo escribible:
//   ¿quien puede escribir esto, y QUE GANA si miente?
// ===========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- roles
    //
    // §9.2: el rol va en un CUSTOM CLAIM, no en un documento.
    //
    // `get(/databases/$(database)/documents/usuarios/$(uid)).data.rol` cuesta
    // UNA LECTURA FACTURADA POR CADA EVALUACION.  Con el panel abierto sobre
    // una lista de 200 productos son 200 lecturas extra por pantalla, y son
    // INVISIBLES en cualquier auditoria de codigo porque no aparecen en
    // ninguna query.  Contra una cuota de 50.000/dia (§6.3) eso se nota.
    //
    // Ademas un documento se puede falsificar si es escribible; un claim lo
    // firma el Admin SDK.
    function esAdmin() {
      return request.auth != null && request.auth.token.rol == 'admin';
    }

    function editaSolo(permitidos) {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(permitidos);
    }

    function esSlug(s) {
      return s is string && s.matches('[a-z0-9]+(-[a-z0-9]+)*');
    }

    // ------------------------------------------------------------ productos
    //
    // §5.2 y ADR 008 - las trampas que se cierran ACA:
    //
    //  · `publicado` SIEMPRE presente.  `where('publicado','==',true)` NO
    //    devuelve los documentos donde el campo no existe.  Somos greenfield,
    //    asi que la defensa correcta no es un backfill: es que NINGUN
    //    documento pueda nacer sin el campo.
    //
    //  · `precio` ENTERO en centavos de ARS.  Nunca float, nunca string.
    //    `is int` rechaza 1250.50 y rechaza "1250".
    //
    //  · `imagenes` UN SOLO array de URLs.  En PadelPunilla convivieron DOS
    //    campos `photoUrl` -uno anidado y uno en la raiz- desde el commit
    //    inicial, y aun con la subida arreglada la foto nueva no se veia en
    //    ningun otro lado, PARA SIEMPRE.  Un dato, una ruta.
    //
    //  · LOS OBLIGATORIOS SE EXIGEN EN TODO UPDATE, NO "SI VIENEN".  La
    //    version anterior validaba `precio` solo si estaba en el documento
    //    resultante, asi que un update que lo BORRABA pasaba: un producto
    //    publicado sin precio. Ahora create y update pasan por la misma
    //    `productoValido`, que exige los obligatorios y cierra el documento
    //    con hasOnly -tambien adentro de los mapas: affectedKeys() no mira
    //    adentro de un mapa, asi que cada mapa se valida entero-.
    //
    //  · `stock` y `muestra` son del SERVIDOR.  El panel crea un simple con
    //    stock == 0 y la reposicion llega por callable con increment.  La
    //    regla ve el documento RESULTANTE, no la operacion: no distingue un
    //    increment(10) de un valor absoluto calculado sobre un dato viejo, y
    //    por eso el panel no escribe stock en absoluto.
    //
    //  · `tipo` y `presentacion` son INMUTABLES.  Una botella suelta que pasa
    //    a caja de 2 cambia lo que significa cada unidad de `stock`: es otro
    //    producto, no una edicion.  Y `tipo` existe para que nadie deduzca
    //    "compuesto" por la falta de `stock`, que dejaria a la venta un
    //    producto mal cargado.

    // VARIETALES: la MISMA lista que packages/contratos/src/producto.ts.
    // scripts/ci/auditar_varietales.mjs compara las dos y sale con 1 si
    // difieren.  Agregar una uva es un cambio en los dos lugares.
    function varietalesValidos(v) {
      return v is list
        && v.size() > 0
        && v.toSet().size() == v.size()
        && v.hasOnly([
          // varietales:inicio
          'Malbec',
          'Cabernet Sauvignon',
          'Cabernet Franc',
          'Bonarda',
          'Syrah',
          'Merlot',
          'Pinot Noir',
          'Tannat',
          'Petit Verdot',
          'Tempranillo',
          'Criolla',
          'Chardonnay',
          'Torrontés',
          'Sauvignon Blanc',
          'Semillón',
          'Viognier',
          'Pinot Gris'
          // varietales:fin
        ]);
    }

    function fichaValida(f) {
      return f is map
        && f.keys().hasAll(['bodegaId', 'varietales', 'color', 'organico', 'region', 'volumenMl'])
        && f.keys().hasOnly(['bodegaId', 'varietales', 'color', 'organico', 'anada', 'region', 'volumenMl'])
        && f.bodegaId is string && f.bodegaId.size() > 0
        && varietalesValidos(f.varietales)
        && f.color in ['tinto', 'blanco', 'rosado']
        && f.organico is bool
        && (!('anada' in f) || f.anada == null || (f.anada is int && f.anada > 1800))
        && f.region is string && f.region.size() > 0
        && f.volumenMl is int && f.volumenMl > 0;
    }

    function productoValido(d) {
      return d.keys().hasAll(['tipo', 'slug', 'nombre', 'precio', 'presentacion', 'imagenes', 'publicado', 'fichaVino'])
        && d.keys().hasOnly(['tipo', 'slug', 'nombre', 'precio', 'stock', 'presentacion', 'imagenes', 'publicado', 'muestra', 'fichaVino'])
        && d.tipo in ['simple', 'compuesto']
        && esSlug(d.slug)
        && d.nombre is string && d.nombre.size() > 0
        && d.precio is int && d.precio >= 0
        && d.presentacion is map
        && d.presentacion.keys().hasOnly(['botellas'])
        && d.presentacion.botellas is int && d.presentacion.botellas >= 1
        && d.imagenes is list && d.imagenes.size() <= 10
        && d.publicado is bool
        && fichaValida(d.fichaVino)
        // El simple lleva stock entero; el compuesto no tiene stock propio:
        // lo deriva de sus componentes.
        && ((d.tipo == 'simple' && 'stock' in d && d.stock is int && d.stock >= 0)
            || (d.tipo == 'compuesto' && !('stock' in d)));
    }

    match /productos/{productoId} {
      allow read: if esAdmin();

      allow create: if esAdmin()
        && productoValido(request.resource.data)
        && !('muestra' in request.resource.data)
        // Nace sin stock: el primero llega por la reposicion, del servidor.
        && request.resource.data.get('stock', 0) == 0;

      allow update: if esAdmin()
        && productoValido(request.resource.data)
        && request.resource.data.tipo == resource.data.tipo
        && request.resource.data.presentacion == resource.data.presentacion
        && request.resource.data.get('stock', null) == resource.data.get('stock', null)
        && request.resource.data.get('muestra', null) == resource.data.get('muestra', null);

      allow delete: if esAdmin();
    }

    // -------------------------------------------------------------- bodegas
    //
    // El panel las da de alta.  La forma se cierra en `nombre` y `slug`: la
    // vidriera las lee ENTERAS en cada reconstruccion del catalogo, y cada
    // campo de mas es peso en esa lectura.  `muestra` es del servidor, igual
    // que en productos.
    match /bodegas/{bodegaId} {
      allow read: if esAdmin();
      allow create: if esAdmin()
        && request.resource.data.keys().hasOnly(['nombre', 'slug'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && esSlug(request.resource.data.slug);
      allow update: if esAdmin()
        && request.resource.data.keys().hasOnly(['nombre', 'slug', 'muestra'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && esSlug(request.resource.data.slug)
        && request.resource.data.get('muestra', null) == resource.data.get('muestra', null);
      allow delete: if esAdmin();
    }

    // ------------------------------------------------------------- metricas
    //
    // `metricas/popularidad`: UN documento que se RECALCULA entero sobre una
    // ventana de tiempo y nunca se acumula (ADR 008).  Un contador que suma de
    // a una venta se infla con cada reintento del trigger; uno recalculado da
    // lo mismo si corre dos veces.  Lo escribe solo el servidor; el panel lo
    // lee.  La vidriera recibe el PUESTO, nunca las unidades.
    match /metricas/{documento} {
      allow read: if esAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------------- ordenes
    //
    // El operador LEE y puede mover la ENTREGA a mano desde el panel.  Lo que
    // NO puede es escribir `estadoPago` por escritura directa, ni tocar
    // `items[]`, `total` o `numero` de una orden ya creada.
    //
    // POR QUE: `items[]` es un SNAPSHOT de precios al momento de la compra
    // (§5.2), no una referencia.  Si se puede editar despues, deja de ser un
    // snapshot y el historico de la tienda se vuelve mentira -- justo lo que
    // el snapshot existe para evitar.
    //
    // El cliente NO figura aca en absoluto.  Consulta su orden por la
    // callable `consultarOrden(numero, email)` (§9.1): una lectura directa
    // por id permite ENUMERAR ORDENES AJENAS probando ids.
    match /ordenes/{ordenId} {
      allow read: if esAdmin();

      // Las ordenes nacen SOLO por la transaccion de `crearOrden` (Admin
      // SDK), que es la unica que sabe asignar `numero` contra
      // `contadores/ordenes`.  Nadie las crea desde un cliente.
      allow create: if false;

      allow update: if esAdmin()
        && editaSolo(['estadoEntrega', 'notasOperador', 'actualizadaEn']);

      // Una orden no se borra: se cancela.  Cancelar es un par de estados
      // (ADR 002), no un DELETE -- y el historico de una venta no se tira.
      allow delete: if false;

      // ----------------------------------------------------- idempotencia
      //
      // Los marcadores son la defensa contra el trigger que corre dos veces.
      // Los triggers son AT-LEAST-ONCE: el mismo evento llega repetido.  El
      // marcador se escribe en la MISMA TRANSACCION que el efecto, desde el
      // Admin SDK.
      //
      // Si un cliente pudiera escribir un marcador, podria hacer que un
      // efecto NUNCA ocurra (marcandolo como ya hecho).  Si pudiera borrarlo,
      // podria hacer que ocurra DOS VECES.  Las dos cosas son plata.
      match /marcadores/{efecto} {
        allow read, write: if false;
      }
    }

    // ----------------------------------------------------------------- zonas
    // Cobertura de envio y costo.  El operador las lee; las escribe el
    // servidor.  Un costo de envio editable desde el navegador es un descuento
    // que se pone el comprador.
    match /zonas/{zonaId} {
      allow read: if esAdmin();
      allow write: if false;
    }

    // ---------------------------------------------------------------- config
    //
    // §9.4 - LA BARANDA TIENE QUE PROTEGER LA PRIMERA ESCRITURA.
    //
    // Una condicion anti fat-finger escrita sobre el valor ANTERIOR no sirve
    // en una CREACION, porque no hay "antes" -- y la primera escritura es
    // exactamente cuando mas se equivoca uno.  Por eso `config` es
    // server-only en su totalidad, creacion incluida: la baranda vive en el
    // trigger, sobre el valor NUEVO, y las reglas garantizan que no exista
    // ningun otro camino de escritura que la saltee.
    match /config/{documento} {
      allow read: if esAdmin();
      allow write: if false;
    }

    // ------------------------------------------------------------ contadores
    // Numeracion secuencial de ordenes.  Se toca UNICAMENTE dentro de la
    // transaccion de `crearOrden`.  Dos escrituras concurrentes por fuera de
    // esa transaccion dan dos ordenes con el mismo numero.
    match /contadores/{nombre} {
      allow read, write: if false;
    }

    // ---------------------------------------------------- deny por defecto
    //
    // Esta clausula es redundante con el modelo de Firestore (lo que no se
    // permite, se niega) y esta puesta A PROPOSITO: hace que la intencion sea
    // legible para quien lea el archivo, y que una coleccion nueva que
    // aparezca sin su bloque quede cerrada de forma EXPLICITA en vez de
    // parecer un olvido.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
